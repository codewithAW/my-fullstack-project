{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/api.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api.js" },
    { "src": "/uploads/(.*)", "dest": "/backend/api.js" },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/frames/(.*)", "dest": "/frontend/frames/$1" },
    { "src": "/favicon\\.svg", "dest": "/frontend/favicon.svg" },
    { "src": "/favicon\\.ico", "dest": "/frontend/favicon.ico" },
    { "src": "^/$", "dest": "/frontend/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
